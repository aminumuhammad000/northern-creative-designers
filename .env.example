# Northern Creative Designers Summit Digital Platform
# Environment Configuration Template (.env.example)

# ------------------------------------------------------------------------------
# 1. Site URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Database & Authentication)
# Obtain from: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. Cloudinary Configuration (Image Uploads & Media Storage)
# Obtain from: https://console.cloudinary.com/pm/developer-dashboard
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# ------------------------------------------------------------------------------
# 4. Transactional Email & Security (Optional for local dev)
# ------------------------------------------------------------------------------
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Northern Creative Designers <no-reply@northcdesigners.org>
QR_TOKEN_SECRET=your-cryptographic-token-secret
